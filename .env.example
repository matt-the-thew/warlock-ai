# Issue this key from a Claude Console workspace with a monthly spend limit:
# that limit is the hard stop on what the key can spend.
ANTHROPIC_API_KEY=
# Estimated monthly chat spend at which /api/ask stops answering (USD,
# default 9.50). Keep it below the workspace limit so chat stops politely
# before the API starts refusing requests mid-answer.
MONTHLY_SPEND_LIMIT_USD=9.50

# Sign-in (optional). Without a publishable key the API treats everyone as
# anonymous and the site's sign-in button does nothing. Get keys from
# https://dashboard.clerk.com/~/api-keys. The site reads this file too
# (astro.config.mjs sets envDir), and only PUBLIC_* values reach the browser.
# Only the publishable key is needed: the site is static and the API
# verifies tokens with Clerk's public keys.
PUBLIC_CLERK_PUBLISHABLE_KEY=
# Origins allowed to mint session tokens, comma-separated (checked against
# the token's azp claim). Leave empty to skip the check.
CLERK_AUTHORIZED_PARTIES=http://localhost:4321

# Proxies in front of the API that append to X-Forwarded-For, used to tell
# anonymous callers apart by IP: 0 locally, 1 on Cloud Run alone, 2 behind the
# site's Cloudflare Worker and then Cloud Run.
TRUSTED_PROXY_HOPS=0
# Shared with the site's Cloudflare Worker, which sends it on every request;
# when set, the API refuses requests without it. Leave empty locally.
PROXY_SECRET=
